(* Syllog implemented grammar — v0.1 parser subset *)

program          = [ module-decl ] , { use-decl } , { item } ;
item             = [ "pub" ] , ( struct-decl | enum-decl | state-decl
                 | function-decl | agent-decl | pipeline-decl
                 | safety-bound-decl ) ;
module-decl      = "module" , path ;
use-decl         = "use" , path , [ "as" , identifier ] ;

struct-decl      = "struct" , identifier , "{" , { typed-field } , "}" ;
enum-decl        = "enum" , identifier , "{" , { enum-variant } , "}" ;
enum-variant     = identifier , [ "(" , [ type , { "," , type } ] , ")" ] ;
state-decl       = "state" , identifier , "{" , { typed-field } , "}" ;
typed-field      = identifier , ":" , type ;

function-decl    = [ "async" ] , "fn" , identifier , "(" , [ parameters ] , ")"
                 , [ "->" , type ] , [ effect-set ] , block ;
parameters       = parameter , { "," , parameter } ;
parameter        = identifier , ":" , type ;
effect-set       = "!" , "{" , [ effect , { "," , effect } ] , "}" ;
effect           = "pure" | "alloc" | "async" | "io" | "network" | "provider" ;

agent-decl       = "agent" , identifier , [ signature ] , property-block ;
pipeline-decl    = "pipeline" , identifier , [ signature ] , property-block ;
safety-bound-decl = "safety_bound" , identifier , property-block ;
signature        = "(" , [ parameters ] , ")" , [ "->" , type ] ;
property-block   = "{" , { identifier , [ ":" , type ] , ":" , expression } , "}" ;

type             = reference-type | array-type | tuple-type | path-type ;
reference-type   = "&" , [ lifetime ] , [ "mut" ] , type ;
lifetime         = "'" , identifier ;
array-type       = "[" , type , "]" ;
tuple-type       = "(" , [ type , { "," , type } ] , ")" ;
path-type        = path , [ "<" , type , { "," , type } , ">" ] ;

block            = "{" , { statement } , "}" ;
statement        = "let" , identifier , [ ":" , type ] , "=" , expression
                 | "return" , [ expression ]
                 | expression ;
expression       = match-expression | binary-expression ;
match-expression = "match" , expression , "{" , { pattern , [ "if" , expression ]
                 , "=>" , expression , [ "," ] } , "}" ;
binary-expression = unary-expression , { binary-operator , unary-expression } ;
unary-expression = [ "!" | "-" | "await" | "&" , [ "mut" ] ] , postfix-expression ;
postfix-expression = primary-expression , { call-suffix | field-suffix } ;
call-suffix      = "(" , [ call-argument , { "," , call-argument } ] , ")" ;
call-argument    = [ identifier , ":" ] , expression ;
field-suffix     = "." , identifier ;
primary-expression = literal | path | array | block | "(" , expression , ")" ;
array            = "[" , [ expression , { "," , expression } ] , "]" ;
pattern          = "_" | literal | path , [ "(" , [ pattern , { "," , pattern } ] , ")" ] ;

path             = identifier , { "::" , identifier } ;
literal          = string | number | "true" | "false" | identifier ;
identifier       = ( letter | "_" ) , { letter | digit | "_" } ;
letter           = "a".."z" | "A".."Z" ;
digit            = "0".."9" ;
